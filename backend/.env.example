APP_NAME=VoltSonic API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voltsonic
SYNC_DATABASE_URL=

VOLTSONIC_RPC_URLS=https://rpc.testnet.chain.robinhood.com
VOLTSONIC_CONTRACT_ADDRESS=0xYOUR_VOLTSONIC_CONTRACT_ADDRESS
# Must be the private key for the contract owner; do not commit this value.
VOLTSONIC_PRIVATE_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
