APP_NAME=VoltSonic API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voltsonic

VOLTSONIC_RPC_URLS=https://sepolia.base.org
VOLTSONIC_CONTRACT_ADDRESS=0xYOUR_VOLTSONIC_PROXY_ADDRESS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SCHEDULER_INTERVAL=5
